# --- Cortex / Neuroid founders dashboard -------------------------------

# Passcodes for the two roles. CHANGE THESE before running anywhere real.
FOUNDERY_FOUNDER_PASSCODE=change-me-founder
FOUNDERY_OPERATOR_PASSCODE=change-me-operator

# Secret used to sign session cookies and public onboarding tokens.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FOUNDERY_SESSION_SECRET=dev-only-insecure-secret-change-me

# --- Database ------------------------------------------------------------
# Leave DATABASE_URL empty for local development: Cortex falls back to
# PGlite (Postgres compiled to WASM) in ./.pglite, so `npm run dev` and
# `npm test` need no database server.
#
# For Supabase, use the *Transaction pooler* connection string (port 6543).
# Supabase dashboard → Connect → Transaction pooler. Serverless functions open
# many short-lived connections, which is exactly what that pooler is for; the
# direct connection on 5432 will run out of slots.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional: paste Supabase's CA certificate here to verify the TLS chain
# properly. Without it the connection is encrypted but the certificate is not
# checked. Supabase dashboard → Settings → Database → SSL configuration.
# FOUNDERY_DB_CA_CERT=

# Optional: connections per serverless instance. 3 is a sane default.
# FOUNDERY_DB_POOL_MAX=3

# --- Presentation --------------------------------------------------------
# Public base URL, used to build shareable client onboarding links. On Vercel
# this defaults to the *.vercel.app production domain if left unset — set it to
# the custom domain (https://cortex.neuroidmedia.com) once that's attached.
FOUNDERY_PUBLIC_URL=http://localhost:3000

# Display currency. INR | USD | GBP | EUR | AED
FOUNDERY_CURRENCY=INR

# --- Sign-in (passwordless) ----------------------------------------------
# Supabase Auth does the identity ceremony (Google, or a 6-digit email code).
# On Vercel the Supabase integration injects the URL and anon key already;
# set them here only for a non-Vercel deployment.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
#
# Who gets in, and as what. Comma-separated emails.
FOUNDERY_FOUNDER_EMAILS=laksh@neuroidmedia.com
FOUNDERY_OPERATOR_EMAILS=
# With no Supabase configured (local dev), the passcode form above is used.

# --- Zoho Books sync ------------------------------------------------------
# Read-only pull of invoices into Cortex. Create a "Self Client" at
# https://api-console.zoho.in → generate a grant code with scope
#   ZohoBooks.invoices.READ
# then exchange it once for a refresh token (see README → Zoho Books sync).
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ORG_ID=
# ZOHO_DC=in
